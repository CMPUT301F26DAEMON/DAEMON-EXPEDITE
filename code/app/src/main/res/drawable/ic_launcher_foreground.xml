<?xml version="1.0" encoding="utf-8"?>
<!--
    App icon: the tent and crescent moon from the splash screen logo (drawable/logo.png),
    traced as vectors so they stay sharp at every launcher size. The paths are in the logo's
    own coordinates (8x the logo's pixels, 960 x 800); the group scales them into the 108dp
    adaptive icon and centres them inside the 66dp safe zone.

    The tent and window are drawn inset by 12 units with a 24-unit round-join stroke, which
    grows them back to full size with rounded corners like the original.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.056"
        android:scaleY="0.056"
        android:translateX="27.12"
        android:translateY="31.71">
        <!-- Tent, with the open door flap on the left. -->
        <path
            android:fillColor="#FFDCDCDC"
            android:strokeColor="#FFDCDCDC"
            android:strokeWidth="24"
            android:strokeLineJoin="round"
            android:pathData="M236.2,302 L718.9,302 L892.4,738 L416.3,738 L253,321.4 L253,738 L67.5,738 Z" />
        <!-- Window, cut out in the background colour. -->
        <path
            android:fillColor="#FF1E211F"
            android:strokeColor="#FF1E211F"
            android:strokeWidth="24"
            android:strokeLineJoin="round"
            android:pathData="M495.5,410 L601.8,410 L647.4,528 L541.2,528 Z" />
        <!-- Crescent moon behind the tent's top-right corner, trimmed to leave a gap. -->
        <path
            android:fillColor="#FFDCDCDC"
            android:pathData="M690,45 A155,155 0 0,0 584,255 L751,255 L782,334 A155,155 0 0,0 870,245 A170,170 0 0,1 690,45 Z" />
    </group>
</vector>
